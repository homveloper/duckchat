// NavigationContainer wraps navigation with proper container context
// This provides the container query context for responsive behavior
// Usage: @NavigationContainer(content)
// templ NavigationContainer(content templ.Component) {
// 	<div class="navigation-wrapper @container">
// 		@content
// 	</div>
// }

// Expected CSS Classes Contract (Tailwind):

// Container classes:
// - @container: Enables container queries
// - navigation-container: Custom navigation container

// Navigation classes (mobile-first):
// - fixed bottom-0 left-0 right-0: Mobile bottom positioning
// - flex flex-row justify-center: Mobile horizontal layout
// - @[768px]:left-0 @[768px]:bottom-auto @[768px]:top-0: Desktop left positioning
// - @[768px]:h-screen @[768px]:w-60: Desktop dimensions
// - @[768px]:flex-col @[768px]:justify-start: Desktop vertical layout

// Item classes:
// - nav-item: Base navigation item
// - flex items-center: Item layout
// - justify-center flex-col gap-1: Mobile centered vertical
// - @[768px]:justify-start @[768px]:flex-row @[768px]:gap-3: Desktop horizontal
// - text-gray-600 hover:text-duck-blue-600: Color states
// - transition-colors duration-200: Smooth color transitions

// Active state classes:
// - nav-item-active: Applied when isActive=true
// - text-duck-blue-600 bg-duck-blue-50: Active colors

// Icon classes:
// - nav-icon: Base icon styling
// - w-5 h-5: Mobile icon size
// - @[768px]:w-6 @[768px]:h-6: Desktop icon size

// Label classes:
// - nav-label: Base label styling
// - text-xs: Mobile label size
// - @[768px]:text-sm: Desktop label size

// Expected JavaScript Interface:

// Navigation state management:
// - NavigationManager class
// - handleNavigationClick(element) function
// - setActiveSection(section) function
// - updateNavigationUI() function
// - saveNavigationState() function
// - restoreNavigationState() function

// Container query detection:
// - detectContainerSize() function
// - onContainerResize(callback) function
// - isDesktopLayout() function

// Session storage integration:
// - saveToSession(state) function
// - loadFromSession() function
// - clearSession() function

// Expected Data Flow:

// 1. Server-side (Go):
//    - Handler creates NavigationData
//    - Determines activeSection from route/user state
//    - Renders Navigation(data) template
//    - Serves to client

// 2. Client-side (JavaScript):
//    - Initializes NavigationManager
//    - Restores state from sessionStorage
//    - Sets up container query listeners
//    - Handles user interactions
//    - Updates server state via HTMX (optional)

// 3. Template Rendering:
//    - Navigation() renders container
//    - NavigationItem() renders individual items
//    - CSS handles responsive layout
//    - JavaScript manages state

