// NavigationData represents the data structure passed to navigation templates
// type NavigationData struct {
// 	CurrentUser    *models.UserContext `json:"currentUser,omitempty"`
// 	ActiveSection  string              `json:"activeSection"`    // "chat" | "profile"
// 	Items          []NavigationItem    `json:"items"`
// 	ContainerClass string              `json:"containerClass"`
// 	LayoutMode     string              `json:"layoutMode"`       // "mobile" | "desktop"
// }

// NavigationItem represents individual navigation items
// type NavigationItem struct {
// 	ID       string `json:"id"`       // "chat" | "profile"
// 	Label    string `json:"label"`    // "Chat" | "Profile"
// 	Icon     string `json:"icon"`     // Heroicon name
// 	IconPath string `json:"iconPath"` // SVG path data
// 	Href     string `json:"href"`     // Target URL
// 	IsActive bool   `json:"isActive"` // Computed active state
// }

