package pages

import (
	"duckchat/internal/ui/models"
	"duckchat/web/templates/components"
	"duckchat/web/templates/layouts"
	"fmt"
)

// ChatPageData contains data for the chat page
type ChatPageData struct {
	ChatState     *models.ChatPageState         `json:"chatState"`
	MessageInput  *models.MessageInputState     `json:"messageInput"`
	TypingState   *models.TypingIndicatorState  `json:"typingState"`
	LayoutState   *models.ResponsiveLayoutState `json:"layoutState"`
	CSRFToken     string                        `json:"csrfToken"`
	ConnectionID  string                        `json:"connectionId,omitempty"`
	ShowSidebar   bool                          `json:"showSidebar"`
	IsMobileView  bool                          `json:"isMobileView"`
}

// ChatPage renders the complete chat interface
templ ChatPage(data ChatPageData, baseLayoutData *layouts.BaseLayoutData) {
	@layouts.BaseLayout(baseLayoutData, ChatPageContent(data))
}

// ChatPageContent renders the main chat page content
templ ChatPageContent(data ChatPageData) {
	<div
		class={
			"chat-page h-full flex",
			templ.KV("mobile-layout", data.IsMobileView),
			templ.KV("desktop-layout", !data.IsMobileView)
		}
		data-testid="chat-page"
		data-room-id={ data.ChatState.CurrentRoom.ID }
		data-user-id={ data.ChatState.CurrentUser.ID }
		hx-sse={ fmt.Sprintf("connect:/sse/chat/%s?user=%s", data.ChatState.CurrentRoom.ID, data.ChatState.CurrentUser.ID) }
		hx-sse-swap="message"
		hx-target="#message-list"
		hx-swap="beforeend"
	>
		<!-- Room sidebar (desktop only) -->
		if data.ShowSidebar && !data.IsMobileView {
			<div class="room-sidebar w-80 flex-shrink-0 border-r border-gray-200 bg-white">
				<!-- Room list component would go here -->
				<div class="h-full overflow-y-auto">
					<div class="p-4 border-b border-gray-200">
						<h3 class="font-medium text-gray-900">Rooms</h3>
					</div>
					<!-- Room list items -->
					<div class="space-y-1 p-2">
						<div class="p-3 rounded-lg bg-duck-blue-50 border border-duck-blue-200">
							<div class="font-medium text-duck-blue-900">{ data.ChatState.CurrentRoom.Name }</div>
							<div class="text-sm text-duck-blue-600">Current room</div>
						</div>
					</div>
				</div>
			</div>
		}

		<!-- Main chat area -->
		<div class="chat-main flex-1 flex flex-col min-w-0">
			<!-- Chat header -->
			@ChatHeader(data.ChatState, data.LayoutState.IsMobile())

			<!-- Messages area -->
			<div class="messages-area flex-1 flex flex-col min-h-0">
				<!-- Message list container -->
				<div
					id="message-list-container"
					class="flex-1 overflow-y-auto bg-gray-50"
					data-testid="message-list-container"
				>
					@MessageList(data.ChatState.Messages, data.ChatState.CurrentUser)
				</div>

				<!-- Typing indicators -->
				<div id="typing-indicators" class="typing-indicators px-4 py-2 bg-gray-50">
					@TypingIndicators(data.TypingState)
				</div>
			</div>

			<!-- Message input area -->
			<div class="message-input-area border-t border-gray-200 bg-white">
				@components.MessageInput(&components.MessageInputData{
					InputState:   data.MessageInput,
					LayoutState:  data.LayoutState,
					IsConnected:  data.ChatState.IsConnected,
					CSRFToken:    data.CSRFToken,
				})
			</div>
		</div>

		<!-- Online users sidebar (desktop only) -->
		if !data.IsMobileView && len(data.ChatState.OnlineUsers) > 0 {
			<div class="online-users-sidebar w-64 flex-shrink-0 border-l border-gray-200 bg-white">
				@OnlineUsersList(data.ChatState.OnlineUsers, data.ChatState.CurrentUser.ID)
			</div>
		}

		<!-- Mobile room info modal (hidden by default) -->
		if data.IsMobileView {
			<div
				id="room-info-modal"
				class="fixed inset-0 bg-black bg-opacity-50 z-50 hidden"
				data-testid="room-info-modal"
			>
				<div class="absolute inset-x-0 bottom-0 bg-white rounded-t-lg max-h-[80vh] overflow-y-auto">
					@RoomInfoPanel(data.ChatState.CurrentRoom, data.ChatState.OnlineUsers, data.ChatState.CurrentUser.ID)
				</div>
			</div>
		}
	</div>

	<!-- Chat page JavaScript -->
	<script>
		// Chat page state management
		const ChatPage = {
			currentRoomId: '{ data.ChatState.CurrentRoom.ID }',
			currentUserId: '{ data.ChatState.CurrentUser.ID }',
			isConnected: { data.ChatState.IsConnected },
			isMobile: { data.IsMobileView },

			init() {
				this.setupMessageList();
				this.setupKeyboardShortcuts();
				this.setupMobileHandlers();
				this.setupSSEHandlers();
				this.markMessagesAsRead();
			},

			setupMessageList() {
				const container = document.getElementById('message-list-container');
				if (container) {
					// Auto-scroll to bottom on new messages
					const observer = new MutationObserver(() => {
						if (this.shouldAutoScroll()) {
							container.scrollTop = container.scrollHeight;
						}
					});

					observer.observe(container, {
						childList: true,
						subtree: true
					});

					// Scroll to bottom initially
					setTimeout(() => {
						container.scrollTop = container.scrollHeight;
					}, 100);
				}
			},

			shouldAutoScroll() {
				const container = document.getElementById('message-list-container');
				if (!container) return false;

				// Auto-scroll if user is near the bottom (within 100px)
				const scrollThreshold = 100;
				const scrollBottom = container.scrollHeight - container.scrollTop - container.clientHeight;
				return scrollBottom < scrollThreshold;
			},

			setupKeyboardShortcuts() {
				document.addEventListener('keydown', (e) => {
					// Escape key closes modals
					if (e.key === 'Escape') {
						this.closeAllModals();
					}

					// Ctrl/Cmd + K to focus message input
					if ((e.ctrlKey || e.metaKey) && e.key === 'k') {
						e.preventDefault();
						const messageInput = document.getElementById('message-content');
						if (messageInput) {
							messageInput.focus();
						}
					}
				});
			},

			setupMobileHandlers() {
				if (!this.isMobile) return;

				// Handle back button navigation
				window.addEventListener('popstate', () => {
					// Return to room list on back
					window.location.href = '/';
				});

				// Handle room info modal
				const modal = document.getElementById('room-info-modal');
				if (modal) {
					modal.addEventListener('click', (e) => {
						if (e.target === modal) {
							this.closeRoomInfoModal();
						}
					});
				}
			},

			setupSSEHandlers() {
				// Handle SSE connection events
				document.addEventListener('htmx:sseError', () => {
					this.isConnected = false;
					this.showConnectionError();
				});

				document.addEventListener('htmx:sseOpen', () => {
					this.isConnected = true;
					this.hideConnectionError();
				});

				// Handle incoming messages
				document.addEventListener('htmx:afterRequest', (e) => {
					if (e.target.id === 'message-list') {
						this.markMessagesAsRead();
					}
				});
			},

			showConnectionError() {
				const errorBanner = document.getElementById('connection-error');
				if (errorBanner) {
					errorBanner.classList.remove('hidden');
				}
			},

			hideConnectionError() {
				const errorBanner = document.getElementById('connection-error');
				if (errorBanner) {
					errorBanner.classList.add('hidden');
				}
			},

			openRoomInfoModal() {
				if (this.isMobile) {
					const modal = document.getElementById('room-info-modal');
					if (modal) {
						modal.classList.remove('hidden');
						document.body.style.overflow = 'hidden';
					}
				}
			},

			closeRoomInfoModal() {
				if (this.isMobile) {
					const modal = document.getElementById('room-info-modal');
					if (modal) {
						modal.classList.add('hidden');
						document.body.style.overflow = '';
					}
				}
			},

			closeAllModals() {
				this.closeRoomInfoModal();
			},

			markMessagesAsRead() {
				// Send read receipt for all visible messages
				if (this.isConnected) {
					fetch(`/rooms/${this.currentRoomId}/read`, {
						method: 'POST',
						headers: {
							'Content-Type': 'application/json',
							'X-CSRF-Token': '{ data.CSRFToken }'
						}
					}).catch(console.error);
				}
			},

			// Utility functions
			formatTime(timestamp) {
				const date = new Date(timestamp);
				const now = new Date();
				const diffMs = now - date;
				const diffMins = Math.floor(diffMs / 60000);

				if (diffMins < 1) return 'just now';
				if (diffMins < 60) return `${diffMins}m ago`;
				if (diffMins < 1440) return `${Math.floor(diffMins / 60)}h ago`;
				return date.toLocaleDateString();
			}
		};

		// Initialize chat page
		document.addEventListener('DOMContentLoaded', () => {
			ChatPage.init();
		});

		// Global functions for template usage
		function openRoomInfo() {
			ChatPage.openRoomInfoModal();
		}

		function closeRoomInfo() {
			ChatPage.closeRoomInfoModal();
		}

		// Handle mobile viewport changes
		window.addEventListener('resize', () => {
			if (window.innerWidth >= 768 && ChatPage.isMobile) {
				// Switched to tablet/desktop, reload page for proper layout
				window.location.reload();
			}
		});
	</script>
}

// ChatHeader renders the chat room header
templ ChatHeader(chatState *models.ChatPageState, isMobile bool) {
	<div class="chat-header flex items-center justify-between p-4 border-b border-gray-200 bg-white" data-testid="chat-header">
		<div class="flex items-center gap-3 min-w-0">
			<!-- Back button (mobile only) -->
			if isMobile {
				<button
					type="button"
					class="btn-touch p-2 -ml-2"
					onclick="history.back()"
					aria-label="Go back to rooms"
					data-testid="back-button"
				>
					<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
					</svg>
				</button>
			}

			<!-- Room info -->
			<div class="min-w-0">
				<h1 class="font-semibold text-gray-900 truncate" data-testid="room-name">
					{ chatState.CurrentRoom.Name }
				</h1>
				<div class="flex items-center gap-2 text-sm text-gray-500">
					<!-- Connection status -->
					if chatState.IsConnected {
						<div class="flex items-center gap-1">
							<div class="w-2 h-2 bg-green-500 rounded-full" title="Connected"></div>
							<span>Connected</span>
						</div>
					} else {
						<div class="flex items-center gap-1">
							<div class="w-2 h-2 bg-red-500 rounded-full animate-pulse" title="Disconnected"></div>
							<span>Disconnected</span>
						</div>
					}

					<!-- Participant count -->
					<span>•</span>
					<span>{ chatState.GetParticipantSummary() }</span>
				</div>
			</div>
		</div>

		<div class="flex items-center gap-2">
			<!-- Room info button -->
			<button
				type="button"
				class="btn-touch p-2 text-gray-500 hover:text-gray-700"
				onclick="openRoomInfo()"
				aria-label="Room information"
				data-testid="room-info-button"
			>
				<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
				</svg>
			</button>

			<!-- Room options (owner only) -->
			if chatState.HasPermission("edit_room") {
				<button
					type="button"
					class="btn-touch p-2 text-gray-500 hover:text-gray-700"
					onclick="toggleRoomOptions(this)"
					aria-label="Room options"
					data-testid="room-options"
				>
					<svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
						<path d="M12 8c1.1 0 2-.9 2-2s-.9-2-2-2-2 .9-2 2 .9 2 2 2zm0 2c-1.1 0-2 .9-2 2s.9 2 2 2 2-.9 2-2-.9-2-2-2zm0 6c-1.1 0-2 .9-2 2s.9 2 2 2 2-.9 2-2-.9-2-2-2z"/>
					</svg>
				</button>
			}
		</div>
	</div>
}

// MessageList renders the list of chat messages
templ MessageList(messages []*models.MessageViewModel, currentUser *models.UserContext) {
	<div id="message-list" class="message-list space-y-4 p-4" data-testid="message-list" role="log" aria-label="Chat messages">
		if len(messages) == 0 {
			<!-- Empty state -->
			<div class="text-center py-12" data-testid="empty-messages">
				<svg class="w-12 h-12 text-gray-300 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-3.582 8-8 8a8.013 8.013 0 01-7-4L5 20l4-1a8.013 8.013 0 01-4-7c0-4.418 3.582-8 8-8s8 3.582 8 8z"/>
				</svg>
				<h3 class="text-lg font-medium text-gray-900 mb-2">No messages yet</h3>
				<p class="text-gray-500">Be the first to say something!</p>
			</div>
		} else {
			for i, message := range messages {
				@MessageItem(message, currentUser, i == 0 || messages[i-1].UserID != message.UserID)
			}
		}
	</div>
}

// MessageItem renders an individual message
templ MessageItem(message *models.MessageViewModel, currentUser *models.UserContext, showAvatar bool) {
	<div
		class={
			"message-item flex gap-3",
			templ.KV("flex-row-reverse", message.IsCurrentUser),
			templ.KV("system-message justify-center", message.MessageType == models.MessageTypeSystem),
			templ.KV("notification-message justify-center", message.MessageType == models.MessageTypeNotification)
		}
		data-testid="message-item"
		data-message-id={ message.ID }
		data-user-id={ message.UserID }
	>
		if message.MessageType == models.MessageTypeText {
			<!-- User avatar -->
			<div class="flex-shrink-0">
				if showAvatar {
					if message.AvatarURL != nil && *message.AvatarURL != "" {
						<img
							src={ *message.AvatarURL }
							alt={ message.Username + " avatar" }
							class="w-8 h-8 rounded-full"
						/>
					} else {
						<div class="w-8 h-8 rounded-full bg-duck-blue-500 flex items-center justify-center text-white text-sm font-medium">
							{ string(message.Username[0]) }
						</div>
					}
				} else {
					<div class="w-8 h-8"></div>
				}
			</div>

			<!-- Message content -->
			<div class={ "flex-1 max-w-lg", templ.KV("text-right", message.IsCurrentUser) }>
				<!-- Username and timestamp -->
				if showAvatar {
					<div class={ "flex items-center gap-2 mb-1", templ.KV("flex-row-reverse", message.IsCurrentUser) }>
						<span class="font-medium text-sm text-gray-900">
							{ message.Username }
						</span>
						<span class="text-xs text-gray-500">
							{ message.Timestamp.Format("3:04 PM") }
						</span>
						if message.IsEdited {
							<span class="text-xs text-gray-400">(edited)</span>
						}
					</div>
				}

				<!-- Message bubble -->
				<div
					class={
						"message-bubble inline-block px-4 py-2 rounded-lg max-w-full break-words",
						templ.KV("bg-duck-blue-600 text-white rounded-br-sm", message.IsCurrentUser),
						templ.KV("bg-white border border-gray-200 text-gray-900 rounded-bl-sm", !message.IsCurrentUser)
					}
				>
					<p class="text-sm leading-relaxed whitespace-pre-wrap">{ message.Content }</p>
				</div>

				<!-- Timestamp for bubbles without avatar -->
				if !showAvatar {
					<div class={ "text-xs text-gray-400 mt-1 px-4", templ.KV("text-right", message.IsCurrentUser) }>
						{ message.Timestamp.Format("3:04 PM") }
						if message.IsEdited {
							<span>(edited)</span>
						}
					</div>
				}
			</div>
		} else {
			<!-- System/notification messages -->
			<div class="system-message-content text-center py-2">
				<div class="inline-flex items-center gap-2 px-3 py-1 bg-gray-100 rounded-full text-sm text-gray-600">
					if message.MessageType == models.MessageTypeUserJoined {
						<svg class="w-4 h-4 text-green-500" fill="currentColor" viewBox="0 0 24 24">
							<path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
						</svg>
					} else if message.MessageType == models.MessageTypeUserLeft {
						<svg class="w-4 h-4 text-red-500" fill="currentColor" viewBox="0 0 24 24">
							<path d="M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z"/>
						</svg>
					}
					<span>{ message.Content }</span>
					<span class="text-xs">{ message.Timestamp.Format("3:04 PM") }</span>
				</div>
			</div>
		}
	</div>
}

// TypingIndicators renders typing indicators
templ TypingIndicators(typingState *models.TypingIndicatorState) {
	<div
		class={
			"typing-indicators transition-all duration-300",
			templ.KV("opacity-0 h-0", !typingState.IsVisible),
			templ.KV("opacity-100 h-auto", typingState.IsVisible)
		}
		data-testid="typing-indicators"
	>
		if typingState.IsVisible && typingState.FormattedText != "" {
			<div class="flex items-center gap-2 text-sm text-gray-500">
				<div class="flex gap-1">
					<div class="w-2 h-2 bg-gray-400 rounded-full animate-bounce"></div>
					<div class="w-2 h-2 bg-gray-400 rounded-full animate-bounce" style="animation-delay: 0.1s"></div>
					<div class="w-2 h-2 bg-gray-400 rounded-full animate-bounce" style="animation-delay: 0.2s"></div>
				</div>
				<span>{ typingState.FormattedText }</span>
			</div>
		}
	</div>
}

// OnlineUsersList renders the online users sidebar
templ OnlineUsersList(onlineUsers []*models.UserContext, currentUserID string) {
	<div class="online-users-list h-full overflow-y-auto" data-testid="online-users-list">
		<div class="p-4 border-b border-gray-200">
			<h3 class="font-medium text-gray-900">
				Online ({ fmt.Sprintf("%d", len(onlineUsers)) })
			</h3>
		</div>

		<div class="p-2 space-y-1">
			for _, user := range onlineUsers {
				<div
					class={
						"flex items-center gap-3 p-2 rounded-lg",
						templ.KV("bg-duck-blue-50", user.ID == currentUserID),
						templ.KV("hover:bg-gray-50", user.ID != currentUserID)
					}
					data-testid="online-user"
					data-user-id={ user.ID }
				>
					<!-- User avatar -->
					if user.AvatarURL != nil && *user.AvatarURL != "" {
						<img
							src={ *user.AvatarURL }
							alt={ user.Username + " avatar" }
							class="w-8 h-8 rounded-full"
						/>
					} else {
						<div class="w-8 h-8 rounded-full bg-duck-blue-500 flex items-center justify-center text-white text-sm font-medium">
							{ string(user.Username[0]) }
						</div>
					}

					<!-- User info -->
					<div class="flex-1 min-w-0">
						<div class="flex items-center gap-2">
							<span class="font-medium text-sm text-gray-900 truncate">
								{ user.Username }
								if user.ID == currentUserID {
									<span class="text-xs text-duck-blue-600">(you)</span>
								}
							</span>
							<div class="w-2 h-2 bg-green-500 rounded-full flex-shrink-0" title="Online"></div>
						</div>

						if user.IsTyping {
							<div class="text-xs text-gray-500 flex items-center gap-1">
								<span>typing</span>
								<div class="flex gap-px">
									<div class="w-1 h-1 bg-gray-400 rounded-full animate-bounce"></div>
									<div class="w-1 h-1 bg-gray-400 rounded-full animate-bounce" style="animation-delay: 0.1s"></div>
									<div class="w-1 h-1 bg-gray-400 rounded-full animate-bounce" style="animation-delay: 0.2s"></div>
								</div>
							</div>
						} else if user.LastActivity != nil {
							<div class="text-xs text-gray-500">
								Last seen { user.LastActivity.Format("3:04 PM") }
							</div>
						}
					</div>
				</div>
			}
		</div>
	</div>
}

// RoomInfoPanel renders room information panel (mobile modal)
templ RoomInfoPanel(room *models.ChatRoomContext, onlineUsers []*models.UserContext, currentUserID string) {
	<div class="room-info-panel p-4 space-y-6" data-testid="room-info-panel">
		<!-- Header -->
		<div class="flex items-center justify-between">
			<h2 class="text-lg font-semibold text-gray-900">Room Information</h2>
			<button
				type="button"
				class="btn-touch p-2 text-gray-500"
				onclick="closeRoomInfo()"
				aria-label="Close"
			>
				<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
				</svg>
			</button>
		</div>

		<!-- Room details -->
		<div class="space-y-4">
			<div>
				<h3 class="font-medium text-gray-900 mb-1">{ room.Name }</h3>
				if room.Description != nil && *room.Description != "" {
					<p class="text-sm text-gray-600">{ *room.Description }</p>
				}
			</div>

			<div class="flex items-center gap-4 text-sm text-gray-500">
				<div class="flex items-center gap-1">
					<svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
						<path d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
					</svg>
					<span>{ fmt.Sprintf("%d participants", room.ParticipantCount) }</span>
				</div>

				if room.IsPrivate {
					<div class="flex items-center gap-1">
						<svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
							<path d="M12 1l-2 7h4l-2-7zm-1 9h2v2h-2v-2zm0 4h2v2h-2v-2z"/>
						</svg>
						<span>Private room</span>
					</div>
				}

				<div class="text-xs">
					Created { room.CreatedAt.Format("Jan 2, 2006") }
				</div>
			</div>
		</div>

		<!-- Online users -->
		<div>
			<h3 class="font-medium text-gray-900 mb-3">
				Online Users ({ fmt.Sprintf("%d", len(onlineUsers)) })
			</h3>
			<div class="space-y-2">
				for _, user := range onlineUsers {
					<div class="flex items-center gap-3 p-2 rounded-lg bg-gray-50">
						if user.AvatarURL != nil && *user.AvatarURL != "" {
							<img src={ *user.AvatarURL } alt={ user.Username + " avatar" } class="w-6 h-6 rounded-full"/>
						} else {
							<div class="w-6 h-6 rounded-full bg-duck-blue-500 flex items-center justify-center text-white text-xs font-medium">
								{ string(user.Username[0]) }
							</div>
						}
						<span class="text-sm text-gray-900">
							{ user.Username }
							if user.ID == currentUserID {
								<span class="text-duck-blue-600">(you)</span>
							}
						</span>
						if user.IsTyping {
							<span class="text-xs text-gray-500">typing...</span>
						}
					</div>
				}
			</div>
		</div>
	</div>
}