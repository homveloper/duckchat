package components

import (
	"duckchat/internal/ui/models"
	"fmt"
	"time"
)

// RoomListData contains data for the room list component
type RoomListData struct {
	Rooms           []*RoomListItem
	CurrentUser     *models.UserContext
	CurrentRoomID   string
	CreateState     *models.RoomCreationState
	IsLoading       bool
	LoadingError    string
	SearchQuery     string
	FilterType      string // "all", "public", "private"
	HasMoreRooms    bool
	IsSSEConnected  bool
	ShowCreateForm  bool
	LayoutState     *models.ResponsiveLayoutState
}

// RoomListItem represents a single room in the list
type RoomListItem struct {
	ID                string
	Name              string
	Description       *string
	ParticipantCount  int
	OnlineCount       int
	HasUnreadMessages bool
	UnreadCount       int
	IsPrivate         bool
	LastActivity      *time.Time
	LastMessage       *string
	IsOnline          bool
	UserRole          string // "owner", "member", "none"
}

// NewRoomListData creates a new RoomListData with defaults
func NewRoomListData(user *models.UserContext, createState *models.RoomCreationState) *RoomListData {
	return &RoomListData{
		Rooms:          make([]*RoomListItem, 0),
		CurrentUser:    user,
		CreateState:    createState,
		IsLoading:      false,
		LoadingError:   "",
		SearchQuery:    "",
		FilterType:     "all",
		HasMoreRooms:   false,
		IsSSEConnected: false,
		ShowCreateForm: false,
	}
}

// RoomList renders the room list component with creation interface
templ RoomList(data *RoomListData) {
	<div
		class="room-list h-full flex flex-col bg-white border-r border-gray-200"
		data-testid="room-list"
		id="room-list-container"
		hx-ext="sse"
	>
		<!-- Room list header -->
		<div class="room-list-header flex-shrink-0 p-4 border-b border-gray-200 bg-white">
			<!-- Current user info (if authenticated) -->
			if data.CurrentUser != nil {
				<div class="flex items-center justify-between mb-3 p-3 bg-duck-blue-50 rounded-lg border border-duck-blue-200">
					<div class="flex items-center space-x-3">
						<!-- User avatar or initial -->
						<div class="flex-shrink-0">
							if data.CurrentUser.AvatarURL != nil && *data.CurrentUser.AvatarURL != "" {
								<img
									class="w-8 h-8 rounded-full"
									src={ *data.CurrentUser.AvatarURL }
									alt={ data.CurrentUser.Username + "'s avatar" }
									data-testid="user-avatar"
								/>
							} else {
								<div
									class="w-8 h-8 rounded-full bg-duck-blue-500 text-white flex items-center justify-center text-sm font-medium"
									data-testid="user-initial"
								>
									{ string([]rune(data.CurrentUser.Username)[0]) }
								</div>
							}
						</div>

						<!-- User info -->
						<div class="flex-1 min-w-0">
							<div class="flex items-center space-x-2">
								<p class="text-sm font-medium text-gray-900 truncate" data-testid="current-username">
									{ data.CurrentUser.Username }
								</p>
								<!-- Online status indicator -->
								if data.CurrentUser.IsOnline {
									<div
										class="w-2 h-2 bg-green-500 rounded-full"
										title="Online"
										data-testid="user-online-status"
									></div>
								} else {
									<div
										class="w-2 h-2 bg-gray-400 rounded-full"
										title="Offline"
										data-testid="user-offline-status"
									></div>
								}
							</div>
							<!-- Tab info for multi-tab awareness (development) -->
							<p class="text-xs text-gray-500" id="tab-info" data-testid="tab-info">
								Tab: <span id="current-tab-id">Loading...</span>
							</p>
						</div>
					</div>

					<!-- Logout button -->
					<button
						type="button"
						onclick="confirmLogout()"
						class="btn-touch p-2 text-gray-500 hover:text-red-600 hover:bg-red-50 rounded-lg transition-colors"
						aria-label="Logout from current tab"
						data-testid="logout-button"
						title="Logout from this tab"
					>
						<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/>
						</svg>
					</button>
				</div>
			}

			<div class="flex items-center justify-between mb-3">
				<h2 class="text-lg font-semibold text-gray-900" data-testid="room-list-title">
					Rooms
				</h2>

				<!-- Connection status indicator -->
				<div class="flex items-center gap-2">
					if data.IsSSEConnected {
						<div
							class="w-2 h-2 bg-green-500 rounded-full"
							title="Connected"
							data-testid="connection-status"
							aria-label="Connected to real-time updates"
						></div>
					} else {
						<div
							class="w-2 h-2 bg-red-500 rounded-full animate-pulse"
							title="Disconnected"
							data-testid="connection-status"
							aria-label="Disconnected from real-time updates"
						></div>
					}

					<!-- New room button -->
					<button
						type="button"
						class="btn-touch p-2 text-duck-blue-600 hover:text-duck-blue-700 hover:bg-duck-blue-50 rounded-lg transition-colors"
						onclick="toggleCreateForm()"
						aria-label="Create new room"
						data-testid="new-room-button"
						disabled?={ data.IsLoading }
					>
						<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
						</svg>
					</button>
				</div>
			</div>

			<!-- Search bar -->
			<div class="relative">
				<input
					type="text"
					placeholder="Search rooms..."
					value={ data.SearchQuery }
					class="w-full pl-10 pr-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-duck-blue-500 focus:border-transparent text-sm bg-gray-50"
					hx-get="/rooms/search"
					hx-trigger="input changed delay:300ms, search"
					hx-target="#room-list-content"
					hx-swap="innerHTML"
					hx-indicator="#search-spinner"
					data-testid="room-search"
				/>
				<div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
					<svg class="w-4 h-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
					</svg>
				</div>
				<div id="search-spinner" class="htmx-indicator absolute inset-y-0 right-0 pr-3 flex items-center">
					<svg class="w-4 h-4 animate-spin text-gray-400" fill="none" viewBox="0 0 24 24">
						<circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"/>
						<path class="opacity-75" fill="currentColor" d="m4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"/>
					</svg>
				</div>
			</div>
		</div>

		<!-- Room creation form (collapsible) -->
		<div
			id="create-room-form"
			class={ "room-creation-form transition-all duration-300 border-b border-gray-200 bg-gray-50", templ.KV("max-h-0 overflow-hidden", !data.ShowCreateForm), templ.KV("max-h-96 overflow-visible", data.ShowCreateForm) }
			data-testid="create-room-form"
		>
			if data.ShowCreateForm {
				@RoomCreationForm(data.CreateState)
			}
		</div>

		<!-- Loading state -->
		if data.IsLoading {
			<div class="flex-1 flex items-center justify-center p-8" data-testid="loading-state">
				<div class="text-center">
					<svg class="w-8 h-8 animate-spin text-duck-blue-500 mx-auto mb-2" fill="none" viewBox="0 0 24 24">
						<circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"/>
						<path class="opacity-75" fill="currentColor" d="m4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"/>
					</svg>
					<p class="text-sm text-gray-500">Loading rooms...</p>
				</div>
			</div>
		} else if data.LoadingError != "" {
			<!-- Error state -->
			<div class="flex-1 flex items-center justify-center p-8" data-testid="error-state">
				<div class="text-center">
					<svg class="w-8 h-8 text-red-500 mx-auto mb-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.964-.833-2.732 0L3.732 16.5c-.77.833.192 2.5 1.732 2.5z"/>
					</svg>
					<p class="text-sm text-red-600 mb-2">{ data.LoadingError }</p>
					<button
						type="button"
						class="text-sm text-duck-blue-600 hover:text-duck-blue-700 font-medium"
						hx-get="/rooms"
						hx-target="#room-list-content"
						hx-swap="innerHTML"
						data-testid="retry-button"
					>
						Try again
					</button>
				</div>
			</div>
		} else {
			<!-- Room list content -->
			<div id="room-list-content" class="flex-1 overflow-y-auto" data-testid="room-list-content">
				if len(data.Rooms) == 0 {
					<!-- Empty state -->
					<div class="flex flex-col items-center justify-center p-8 text-center" data-testid="empty-state">
						<svg class="w-12 h-12 text-gray-300 mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8h2a2 2 0 012 2v6a2 2 0 01-2 2h-2v4l-4-4H9a2 2 0 01-2-2v-6a2 2 0 012-2h2V4a2 2 0 012-2h4a2 2 0 012 2v4z"/>
						</svg>
						<h3 class="text-lg font-medium text-gray-900 mb-2">No rooms yet</h3>
						<p class="text-sm text-gray-500 mb-4">Create your first room to start chatting!</p>
						<button
							type="button"
							class="btn-primary"
							onclick="toggleCreateForm()"
							data-testid="create-first-room"
						>
							Create Room
						</button>
					</div>
				} else {
					<!-- Room list items -->
					<div class="divide-y divide-gray-200" role="list" aria-label="Chat rooms">
						for _, room := range data.Rooms {
							@RoomListItemComponent(room, data.CurrentRoomID, data.LayoutState)
						}
					</div>
				}
			</div>
		}

		<!-- Room list footer (user quota info) -->
		if data.CreateState != nil {
			<div class="room-list-footer flex-shrink-0 p-4 border-t border-gray-200 bg-gray-50">
				<p class="text-xs text-gray-500 text-center">
					You can create up to { fmt.Sprintf("%d", models.MaxRoomsPerUser) } rooms
					if data.CreateState != nil {
						<!-- Show remaining quota -->
						<span class="block mt-1">
							{ fmt.Sprintf("%d remaining", models.MaxRoomsPerUser - len(data.Rooms)) }
						</span>
					}
				</p>
			</div>
		}
	</div>

	<!-- Toast notification container -->
	@ToastContainer()

	<!-- JavaScript for room list interactions -->
	<script>
		// Configure SSE connection using tab-specific authentication
		document.addEventListener('DOMContentLoaded', function() {
			// Primary: Check sessionStorage for tab-specific authentication
			let authToken = sessionStorage.getItem('auth_token');
			let userId = sessionStorage.getItem('user_id');
			let username = sessionStorage.getItem('username');
			let tabId = sessionStorage.getItem('tab_id');

			// Update tab info display
			updateTabInfoDisplay(tabId, username);

			if (authToken) {
				console.log(`Tab-specific authentication found - Tab: ${tabId}, User: ${username}`);

				// Show welcome toast on initial page load
				if (username && !sessionStorage.getItem('welcome_shown_' + tabId)) {
					showSuccessToast('Welcome!', `Signed in as ${username}`, 4000);
					sessionStorage.setItem('welcome_shown_' + tabId, 'true');
				}

				// Ensure cookie is set for current tab
				updateCookieForActiveTab();

				console.log('Found tab-specific auth token, setting up SSE connection...');

				// Check if HTMX is loaded
				if (typeof htmx !== 'undefined') {
					// Set up tab-specific SSE connection
					initializeTabSSEConnection(authToken, tabId, username);
				} else {
					console.error('HTMX not loaded');
				}
			} else {
				console.log('No tab-specific authentication found');

				// Check localStorage for recent accounts (for UI hints, not auto-login)
				const recentAccounts = JSON.parse(localStorage.getItem('recent_accounts') || '[]');
				if (recentAccounts.length > 0) {
					console.log(`Found ${recentAccounts.length} recent accounts in localStorage:`,
						recentAccounts.map(acc => acc.username));
					// Could show recent account suggestions in login form
				}

				console.warn('No tab-specific authentication - redirecting to login or showing account selection');
			}
		});

		// Tab-specific SSE connection management (prevent redeclaration)
		if (typeof window.window.currentSSEConnection === 'undefined') {
			window.window.currentSSEConnection = null;
		}
		if (typeof window.window.sseReconnectTimeout === 'undefined') {
			window.window.sseReconnectTimeout = null;
		}
		if (typeof window.window.previousTabToken === 'undefined') {
			window.window.previousTabToken = null; // Track previous tab's token for cleanup
		}

		// Dynamic cookie management functions
		function setTabCookie(authToken, tabId) {
			if (!authToken) return;

			// Set auth token with expiration
			const expires = new Date();
			expires.setTime(expires.getTime() + (24 * 60 * 60 * 1000)); // 24 hours

			document.cookie = `auth_token=${authToken}; path=/; samesite=strict; expires=${expires.toUTCString()}`;
			console.log(`Set auth cookie for tab ${tabId}`);

			// Store current token for cleanup
			window.previousTabToken = authToken;
		}

		function clearAuthCookie() {
			// Clear the auth token cookie
			document.cookie = 'auth_token=; path=/; samesite=strict; expires=Thu, 01 Jan 1970 00:00:00 UTC;';
			console.log('Cleared auth cookie');
			window.previousTabToken = null;
		}

		function getCookieValue(name) {
			const nameEQ = name + "=";
			const ca = document.cookie.split(';');
			for(let i = 0; i < ca.length; i++) {
				let c = ca[i];
				while (c.charAt(0) == ' ') c = c.substring(1, c.length);
				if (c.indexOf(nameEQ) == 0) return c.substring(nameEQ.length, c.length);
			}
			return null;
		}

		function updateCookieForActiveTab() {
			const authToken = sessionStorage.getItem('auth_token');
			const tabId = sessionStorage.getItem('tab_id');

			if (authToken) {
				// Only update if different from current cookie
				const currentCookie = getCookieValue('auth_token');
				if (currentCookie !== authToken) {
					setTabCookie(authToken, tabId);
					console.log(`Updated cookie for active tab ${tabId}`);
				}
			} else {
				// Clear cookie if no auth token
				clearAuthCookie();
			}
		}

		// Tab-specific logout function
		function logoutCurrentTab() {
			const tabId = sessionStorage.getItem('tab_id');
			const username = sessionStorage.getItem('username');

			console.log(`Logging out tab ${tabId} (${username})`);

			// Show logging out toast
			showInfoToast('Logging out...', `Signing out ${username} from this tab`, 2000);

			// Disconnect SSE first
			disconnectSSE();

			// Clear session storage for this tab
			sessionStorage.removeItem('auth_token');
			sessionStorage.removeItem('user_id');
			sessionStorage.removeItem('username');
			sessionStorage.removeItem('tab_id');

			// Clear welcome flag
			sessionStorage.removeItem('welcome_shown_' + tabId);

			// Clear cookie (this will affect other tabs, but they will reset it when active)
			clearAuthCookie();

			// Show success toast then redirect after a brief delay
			setTimeout(() => {
				showSuccessToast('Logged out', 'You have been signed out successfully', 2000);
				setTimeout(() => {
					window.location.href = '/login';
				}, 1000);
			}, 500);
		}

		// Logout confirmation function
		function confirmLogout() {
			const username = sessionStorage.getItem('username') || 'current user';
			const tabId = sessionStorage.getItem('tab_id') || 'this tab';

			showWarningToast(
				'Confirm Logout',
				`Sign out ${username} from ${tabId}? Click logout button again to confirm.`,
				5000
			);

			// Add temporary confirmation state
			const logoutBtn = document.querySelector('[data-testid="logout-button"]');
			if (logoutBtn) {
				logoutBtn.onclick = () => logoutCurrentTab();
				logoutBtn.innerHTML = `
					<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
					</svg>
				`;
				logoutBtn.title = 'Click to confirm logout';
				logoutBtn.classList.add('text-red-600', 'hover:text-red-700', 'bg-red-50');

				// Reset after 5 seconds
				setTimeout(() => {
					logoutBtn.onclick = () => confirmLogout();
					logoutBtn.innerHTML = `
						<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/>
						</svg>
					`;
					logoutBtn.title = 'Logout from this tab';
					logoutBtn.classList.remove('text-red-600', 'hover:text-red-700', 'bg-red-50');
				}, 5000);
			}
		}

		// Update tab info display
		function updateTabInfoDisplay(tabId, username) {
			const tabInfoElement = document.getElementById('current-tab-id');
			if (tabInfoElement) {
				if (tabId) {
					// Show short version of tab ID for cleaner display
					const shortTabId = tabId.split('_').slice(-1)[0] || tabId.substr(-8);
					tabInfoElement.textContent = shortTabId;
				} else {
					tabInfoElement.textContent = 'Unknown';
				}
			}
		}

		// Make logout function available globally
		window.logoutCurrentTab = logoutCurrentTab;
		window.confirmLogout = confirmLogout;

		function initializeTabSSEConnection(authToken, tabId, username) {
			console.log(`Initializing HTMX SSE connection for tab ${tabId} (${username})`);

			// Clean up existing connection
			if (window.currentSSEConnection) {
				disconnectSSE();
			}

			// Update cookie with current tab's token using proper cookie management
			setTabCookie(authToken, tabId);

			// Set up SSE connection with HTMX
			const container = document.getElementById('room-list-container');
			if (container) {
				// Remove existing SSE attributes first
				container.removeAttribute('sse-connect');
				container.removeAttribute('sse-swap');

				// Set SSE connection attributes
				container.setAttribute('sse-connect', '/sse/events');
				container.setAttribute('sse-swap', 'notification');

				console.log('HTMX SSE attributes set on container for tab:', tabId);

				// Force HTMX to process the SSE extension
				setTimeout(function() {
					if (typeof htmx.process === 'function') {
						htmx.process(container);
						console.log(`HTMX SSE processing triggered for tab ${tabId}`);

						// Store connection reference
						window.currentSSEConnection = {
							tabId: tabId,
							username: username,
							container: container,
							connected: true,
							authToken: authToken
						};
					} else {
						console.warn('HTMX.process not available');
					}
				}, 100);
			} else {
				console.error('Room list container not found for SSE setup');
			}
		}

		function disconnectSSE() {
			if (window.currentSSEConnection && window.currentSSEConnection.container) {
				console.log(`Disconnecting SSE for tab ${window.currentSSEConnection.tabId} (${window.currentSSEConnection.username})`);

				// Remove SSE attributes from HTMX container
				const container = window.currentSSEConnection.container;
				container.removeAttribute('sse-connect');
				container.removeAttribute('sse-swap');

				// Clear connection reference
				window.currentSSEConnection.connected = false;
				window.currentSSEConnection = null;

				// Clear any reconnect timeouts
				if (window.sseReconnectTimeout) {
					clearTimeout(window.sseReconnectTimeout);
					window.sseReconnectTimeout = null;
				}
			}
		}

		function reconnectSSEIfNeeded() {
			const authToken = sessionStorage.getItem('auth_token');
			const tabId = sessionStorage.getItem('tab_id');
			const username = sessionStorage.getItem('username');

			if (authToken && (!window.currentSSEConnection || !window.currentSSEConnection.connected)) {
				console.log(`Reconnecting SSE for tab ${tabId} (${username})`);
				initializeTabSSEConnection(authToken, tabId, username);
			}
		}

		// Toggle create form visibility
		function toggleCreateForm() {
			const form = document.getElementById('create-room-form');
			const isVisible = form.classList.contains('max-h-96');

			if (isVisible) {
				form.classList.remove('max-h-96', 'overflow-visible');
				form.classList.add('max-h-0', 'overflow-hidden');
			} else {
				form.classList.remove('max-h-0', 'overflow-hidden');
				form.classList.add('max-h-96', 'overflow-visible');
			}

			// Update HTMX to reflect state change
			htmx.trigger(form, 'toggle');
		}

		// Handle room selection for mobile
		function selectRoom(roomId, roomName) {
			// Store selection in session storage for mobile navigation
			if (window.innerWidth < 768) {
				sessionStorage.setItem('selectedRoom', roomId);
				sessionStorage.setItem('selectedRoomName', roomName);
			}

			// Navigate to room
			window.location.href = `/rooms/${roomId}`;
		}

		// Handle SSE connection events with tab context
		document.addEventListener('htmx:sseError', function(e) {
			const tabId = sessionStorage.getItem('tab_id');
			const username = sessionStorage.getItem('username');
			console.error(`SSE connection error for tab ${tabId} (${username}):`, e.detail);

			// Update connection status
			if (window.currentSSEConnection) {
				window.currentSSEConnection.connected = false;
			}

			const statusIndicator = document.querySelector('[data-testid="connection-status"]');
			if (statusIndicator) {
				statusIndicator.className = 'w-2 h-2 bg-red-500 rounded-full animate-pulse';
				statusIndicator.title = 'Disconnected';
				statusIndicator.setAttribute('aria-label', 'Disconnected from real-time updates');
			}

			// Attempt to reconnect after a delay
			window.sseReconnectTimeout = setTimeout(() => {
				if (!document.hidden) { // Only reconnect if tab is active
					reconnectSSEIfNeeded();
				}
			}, 5000);
		});

		document.addEventListener('htmx:sseOpen', function(e) {
			const tabId = sessionStorage.getItem('tab_id');
			const username = sessionStorage.getItem('username');
			console.log(`SSE connection opened successfully for tab ${tabId} (${username})`);

			// Update connection status
			if (window.currentSSEConnection) {
				window.currentSSEConnection.connected = true;
			}

			const statusIndicator = document.querySelector('[data-testid="connection-status"]');
			if (statusIndicator) {
				statusIndicator.className = 'w-2 h-2 bg-green-500 rounded-full';
				statusIndicator.title = 'Connected';
				statusIndicator.setAttribute('aria-label', 'Connected to real-time updates');
			}

			// Clear any reconnect timeouts
			if (window.sseReconnectTimeout) {
				clearTimeout(window.sseReconnectTimeout);
				window.sseReconnectTimeout = null;
			}
		});

		document.addEventListener('htmx:sseClose', function(e) {
			const tabId = sessionStorage.getItem('tab_id');
			const username = sessionStorage.getItem('username');
			console.log(`SSE connection closed for tab ${tabId} (${username}):`, e.detail);

			// Update connection status
			if (window.currentSSEConnection) {
				window.currentSSEConnection.connected = false;
			}

			const statusIndicator = document.querySelector('[data-testid="connection-status"]');
			if (statusIndicator) {
				statusIndicator.className = 'w-2 h-2 bg-red-500 rounded-full';
				statusIndicator.title = 'Disconnected';
				statusIndicator.setAttribute('aria-label', 'Disconnected from real-time updates');
			}
		});

		// Handle tab visibility changes for dynamic SSE management
		document.addEventListener('visibilitychange', function() {
			if (!document.hidden) {
				// Tab became active - update cookie and reconnect SSE
				const authToken = sessionStorage.getItem('auth_token');
				const tabId = sessionStorage.getItem('tab_id');
				const username = sessionStorage.getItem('username');

				if (authToken) {
					console.log(`Tab ${tabId} (${username}) became active`);

					// Update cookie for active tab
					updateCookieForActiveTab();

					// Reconnect SSE with current tab's authentication
					window.sseReconnectTimeout = setTimeout(() => {
						reconnectSSEIfNeeded();
					}, 500); // Small delay to ensure tab is fully active
				} else {
					console.log(`Tab ${tabId} became active but no auth token found`);
					// Clear cookie if no auth
					clearAuthCookie();
				}
			} else {
				console.log('Tab became inactive');

				// Clear any pending reconnect timeouts
				if (window.sseReconnectTimeout) {
					clearTimeout(window.sseReconnectTimeout);
					window.sseReconnectTimeout = null;
				}

				// Note: We don't clear cookies on tab inactive to avoid
				// interfering with other tabs that might be active
			}
		});

		// Handle page unload to clean up SSE connection
		window.addEventListener('beforeunload', function() {
			const tabId = sessionStorage.getItem('tab_id');
			const username = sessionStorage.getItem('username');
			console.log(`Tab ${tabId} (${username}) unloading, SSE connection will be closed automatically`);
		});

		// Handle incoming SSE notifications (JSON-RPC 2.0 format)
		document.addEventListener('htmx:sseMessage', function(e) {
			try {
				const notification = JSON.parse(e.detail.data);
				console.log('Received SSE notification:', notification);

				// Handle different notification methods
				switch (notification.method) {
					case 'connected':
						console.log('SSE connection confirmed, client ID:', notification.params.client_id);
						break;

					case 'room.message':
						handleNewMessage(notification.params);
						break;

					case 'room.user_joined':
						handleUserJoined(notification.params);
						break;

					case 'room.user_left':
						handleUserLeft(notification.params);
						break;

					case 'room.updated':
						handleRoomUpdated(notification.params);
						break;

					case 'user.typing':
						handleUserTyping(notification.params);
						break;

					case 'heartbeat':
						// Handle heartbeat silently
						break;

					case 'error':
						console.error('SSE error notification:', notification.params);
						break;

					default:
						console.warn('Unknown SSE notification method:', notification.method);
				}
			} catch (error) {
				console.error('Failed to parse SSE notification:', error, e.detail.data);
			}
		});

		// Handle specific notification types
		function handleNewMessage(params) {
			console.log('New message received:', params);
			// Update unread count for the room
			if (params.room_id) {
				updateRoomUnreadCount(params.room_id, params.message);
			}
		}

		function handleUserJoined(params) {
			console.log('User joined room:', params);
			// Update online count for the room
			if (params.room_id) {
				updateRoomOnlineCount(params.room_id, 1);
			}
		}

		function handleUserLeft(params) {
			console.log('User left room:', params);
			// Update online count for the room
			if (params.room_id) {
				updateRoomOnlineCount(params.room_id, -1);
			}
		}

		function handleRoomUpdated(params) {
			console.log('Room updated:', params);
			// Refresh the room list to get latest data
			htmx.trigger(document.getElementById('room-list-content'), 'refresh');
		}

		function handleUserTyping(params) {
			console.log('User typing:', params);
			// Show typing indicator for the room
			// This would be implemented based on UI requirements
		}

		// Helper functions to update room UI
		function updateRoomUnreadCount(roomId, message) {
			const roomElement = document.querySelector(`[data-room-id="${roomId}"]`);
			if (!roomElement) return;

			// Update unread badge
			let unreadBadge = roomElement.querySelector('[data-testid="unread-badge"]');
			if (!unreadBadge) {
				// Create unread badge if it doesn't exist
				unreadBadge = document.createElement('div');
				unreadBadge.className = 'unread-badge inline-flex items-center justify-center px-2 py-1 text-xs font-bold leading-none text-white bg-duck-blue-600 rounded-full min-w-[1.25rem] h-5';
				unreadBadge.setAttribute('data-testid', 'unread-badge');

				const badgeContainer = roomElement.querySelector('.flex.flex-col.items-end.gap-2.ml-3');
				if (badgeContainer) {
					badgeContainer.insertBefore(unreadBadge, badgeContainer.firstChild);
				}
			}

			// Increment unread count
			let currentCount = parseInt(unreadBadge.textContent) || 0;
			currentCount++;
			unreadBadge.textContent = currentCount > 99 ? '99+' : currentCount.toString();
			unreadBadge.setAttribute('aria-label', `${currentCount} unread messages`);

			// Update last message preview if available
			if (message && message.content) {
				const lastMessageElement = roomElement.querySelector('.text-xs.text-gray-600.truncate.mb-1');
				if (lastMessageElement) {
					lastMessageElement.textContent = message.content;
				}
			}
		}

		function updateRoomOnlineCount(roomId, delta) {
			const roomElement = document.querySelector(`[data-room-id="${roomId}"]`);
			if (!roomElement) return;

			const onlineCountElement = roomElement.querySelector('.bg-green-500.rounded-full').parentElement.querySelector('span');
			if (onlineCountElement) {
				const text = onlineCountElement.textContent;
				const match = text.match(/(\d+) online/);
				if (match) {
					const currentCount = parseInt(match[1]);
					const newCount = Math.max(0, currentCount + delta);
					onlineCountElement.textContent = `${newCount} online`;
				}
			}
		}

		// Handle room updates via SSE
		document.addEventListener('htmx:afterSwap', function(e) {
			if (e.target.id === 'room-list-content') {
				// Reapply any selections or state after content update
				const selectedRoom = sessionStorage.getItem('selectedRoom');
				if (selectedRoom) {
					const roomElement = document.querySelector(`[data-room-id="${selectedRoom}"]`);
					if (roomElement) {
						roomElement.classList.add('bg-duck-blue-50', 'border-duck-blue-200');
					}
				}
			}
		});

		// Search functionality
		document.addEventListener('DOMContentLoaded', function() {
			const searchInput = document.querySelector('[data-testid="room-search"]');
			if (searchInput) {
				// Clear search on escape
				searchInput.addEventListener('keydown', function(e) {
					if (e.key === 'Escape') {
						this.value = '';
						htmx.trigger(this, 'input');
					}
				});
			}
		});

		// Handle mobile touch interactions
		if ('ontouchstart' in window) {
			document.addEventListener('DOMContentLoaded', function() {
				const roomItems = document.querySelectorAll('.room-item');
				roomItems.forEach(item => {
					item.addEventListener('touchstart', function() {
						this.style.backgroundColor = '#f3f4f6'; // gray-100
					});

					item.addEventListener('touchend', function() {
						this.style.backgroundColor = '';
					});
				});
			});
		}
	</script>
}

// RoomListItemComponent renders an individual room list item
templ RoomListItemComponent(room *RoomListItem, currentRoomID string, layoutState *models.ResponsiveLayoutState) {
	<div
		class={
			"room-item relative p-4 hover:bg-gray-50 cursor-pointer transition-colors border-l-4",
			templ.KV("bg-duck-blue-50 border-duck-blue-500", room.ID == currentRoomID),
			templ.KV("border-transparent", room.ID != currentRoomID),
			templ.KV("touch-manipulation", layoutState != nil && layoutState.IsTouchDevice)
		}
		onclick="selectRoom(this.dataset.roomId, this.dataset.roomName)"
		data-room-name={ room.Name }
		role="button"
		tabindex="0"
		aria-label={ fmt.Sprintf("Join %s room", room.Name) }
		data-testid="room-item"
		data-room-id={ room.ID }
		onkeydown="if(event.key==='Enter'||event.key===' ')this.click()"
	>
		<div class="flex items-start justify-between">
			<div class="flex-1 min-w-0">
				<!-- Room name and privacy indicator -->
				<div class="flex items-center gap-2 mb-1">
					<h3 class="text-sm font-medium text-gray-900 truncate">
						{ room.Name }
					</h3>
					if room.IsPrivate {
						<svg class="w-4 h-4 text-gray-400 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" title="Private room">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
						</svg>
					}
					if room.UserRole == "owner" {
						<svg class="w-4 h-4 text-duck-blue-500 flex-shrink-0" fill="currentColor" viewBox="0 0 24 24" title="You own this room">
							<path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
						</svg>
					}
				</div>

				<!-- Room description (if available) -->
				if room.Description != nil && *room.Description != "" {
					<p class="text-xs text-gray-500 mb-2 line-clamp-2">
						{ *room.Description }
					</p>
				}

				<!-- Last message preview -->
				if room.LastMessage != nil {
					<p class="text-xs text-gray-600 truncate mb-1">
						{ *room.LastMessage }
					</p>
				}

				<!-- Room stats -->
				<div class="flex items-center gap-4 text-xs text-gray-500">
					<!-- Participant count -->
					<div class="flex items-center gap-1" title="Participants">
						<svg class="w-3 h-3" fill="currentColor" viewBox="0 0 24 24">
							<path d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
						</svg>
						<span>{ fmt.Sprintf("%d", room.ParticipantCount) }</span>
					</div>

					<!-- Online count -->
					if room.OnlineCount > 0 {
						<div class="flex items-center gap-1" title="Online now">
							<div class="w-2 h-2 bg-green-500 rounded-full"></div>
							<span>{ fmt.Sprintf("%d online", room.OnlineCount) }</span>
						</div>
					}

					<!-- Last activity time -->
					if room.LastActivity != nil {
						<span title={ room.LastActivity.Format("January 2, 2006 at 3:04 PM") }>
							{ formatTimeAgo(*room.LastActivity) }
						</span>
					}
				</div>
			</div>

			<div class="flex flex-col items-end gap-2 ml-3">
				<!-- Unread count badge -->
				if room.UnreadCount > 0 {
					<div
						class="unread-badge inline-flex items-center justify-center px-2 py-1 text-xs font-bold leading-none text-white bg-duck-blue-600 rounded-full min-w-[1.25rem] h-5"
						data-testid="unread-badge"
						aria-label={ fmt.Sprintf("%d unread messages", room.UnreadCount) }
					>
						if room.UnreadCount > 99 {
							99+
						} else {
							{ fmt.Sprintf("%d", room.UnreadCount) }
						}
					</div>
				}

				<!-- Room options menu trigger -->
				<button
					type="button"
					class="room-options-trigger opacity-0 group-hover:opacity-100 p-1 text-gray-400 hover:text-gray-600 rounded transition-opacity"
					onclick="event.stopPropagation(); toggleRoomOptions(this)"
					aria-label="Room options"
					data-testid="room-options"
				>
					<svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
						<path d="M12 8c1.1 0 2-.9 2-2s-.9-2-2-2-2 .9-2 2 .9 2 2 2zm0 2c-1.1 0-2 .9-2 2s.9 2 2 2 2-.9 2-2-.9-2-2-2zm0 6c-1.1 0-2 .9-2 2s.9 2 2 2 2-.9 2-2-.9-2-2-2z"/>
					</svg>
				</button>
			</div>
		</div>

		<!-- Room options dropdown (hidden by default) -->
		<div class="room-options-menu absolute right-4 top-16 hidden bg-white rounded-lg shadow-lg border border-gray-200 py-2 z-10">
			<button type="button" class="w-full text-left px-4 py-2 text-sm text-gray-700 hover:bg-gray-100">
				View Info
			</button>
			if room.UserRole == "owner" {
				<button type="button" class="w-full text-left px-4 py-2 text-sm text-gray-700 hover:bg-gray-100">
					Edit Room
				</button>
				<button type="button" class="w-full text-left px-4 py-2 text-sm text-red-600 hover:bg-gray-100">
					Delete Room
				</button>
			} else {
				<button type="button" class="w-full text-left px-4 py-2 text-sm text-red-600 hover:bg-gray-100">
					Leave Room
				</button>
			}
		</div>
	</div>
}

// RoomCreationForm renders the room creation form
templ RoomCreationForm(state *models.RoomCreationState) {
	<form
		class="p-4 space-y-4"
		hx-post="/rooms/create"
		hx-target="#room-list-content"
		hx-swap="innerHTML"
		hx-indicator="#create-spinner"
		data-testid="room-creation-form"
	>
		<!-- CSRF Token -->
		<input type="hidden" name="csrf_token" value={ state.CSRFToken }/>

		<!-- General error message -->
		if state.GeneralError != "" {
			<div
				class="error-message bg-red-50 border border-red-200 text-red-700 px-3 py-2 rounded-lg text-sm"
				role="alert"
				data-testid="general-error"
			>
				{ state.GeneralError }
			</div>
		}

		<!-- Room name field -->
		<div class="space-y-2">
			<label for="room_name" class="block text-sm font-medium text-gray-700">
				Room Name
			</label>
			<input
				type="text"
				id="room_name"
				name="room_name"
				value={ state.RoomName }
				class={
					"w-full px-3 py-2 border rounded-lg focus:ring-2 focus:ring-duck-blue-500 focus:border-transparent text-sm transition-colors",
					templ.KV("border-red-300 focus:ring-red-500", state.HasFieldError("room_name")),
					templ.KV("border-gray-300", !state.HasFieldError("room_name"))
				}
				placeholder="Enter room name"
				required
				minlength="3"
				maxlength={ fmt.Sprintf("%d", models.MaxRoomNameLength) }
				pattern="[a-zA-Z0-9\s\-_]+"
				disabled?={ state.IsCreating }
				data-testid="room-name-input"
			/>

			if state.HasFieldError("room_name") {
				<p class="text-sm text-red-600" role="alert" data-testid="room-name-error">
					{ state.GetFieldError("room_name") }
				</p>
			}

			<!-- Character count -->
			<p class="text-xs text-gray-500">
				{ fmt.Sprintf("%d/%d characters", len(state.RoomName), models.MaxRoomNameLength) }
			</p>
		</div>

		<!-- Room description field -->
		<div class="space-y-2">
			<label for="description" class="block text-sm font-medium text-gray-700">
				Description (optional)
			</label>
			<textarea
				id="description"
				name="description"
				rows="2"
				class={
					"w-full px-3 py-2 border rounded-lg focus:ring-2 focus:ring-duck-blue-500 focus:border-transparent text-sm resize-none transition-colors",
					templ.KV("border-red-300 focus:ring-red-500", state.HasFieldError("description")),
					templ.KV("border-gray-300", !state.HasFieldError("description"))
				}
				placeholder="Describe your room..."
				maxlength={ fmt.Sprintf("%d", models.MaxRoomDescLength) }
				disabled?={ state.IsCreating }
				data-testid="room-description-input"
			>{ state.Description }</textarea>

			if state.HasFieldError("description") {
				<p class="text-sm text-red-600" role="alert" data-testid="description-error">
					{ state.GetFieldError("description") }
				</p>
			}

			<!-- Character count -->
			<p class="text-xs text-gray-500">
				{ fmt.Sprintf("%d/%d characters", len(state.Description), models.MaxRoomDescLength) }
			</p>
		</div>

		<!-- Privacy setting -->
		<div class="flex items-center space-x-3">
			<input
				type="checkbox"
				id="is_private"
				name="is_private"
				checked?={ state.IsPrivate }
				class="form-checkbox h-4 w-4 text-duck-blue-600 focus:ring-duck-blue-500 border-gray-300 rounded"
				disabled?={ state.IsCreating }
				data-testid="privacy-checkbox"
			/>
			<label for="is_private" class="text-sm text-gray-700">
				Private room (invite-only)
			</label>
		</div>

		<!-- Action buttons -->
		<div class="flex items-center justify-end space-x-3 pt-2">
			<button
				type="button"
				class="btn-secondary text-sm"
				onclick="toggleCreateForm()"
				disabled?={ state.IsCreating }
				data-testid="cancel-create"
			>
				Cancel
			</button>
			<button
				type="submit"
				class="btn-primary text-sm"
				disabled?={ state.IsCreating }
				data-testid="create-submit"
			>
				if state.IsCreating {
					<span class="flex items-center">
						<svg id="create-spinner" class="w-4 h-4 mr-2 animate-spin" fill="none" viewBox="0 0 24 24">
							<circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"/>
							<path class="opacity-75" fill="currentColor" d="m4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"/>
						</svg>
						Creating...
					</span>
				} else {
					Create Room
				}
			</button>
		</div>
	</form>
}

// Helper function to format time ago (would normally be implemented in Go)
func formatTimeAgo(t time.Time) string {
	duration := time.Since(t)

	if duration < time.Minute {
		return "just now"
	} else if duration < time.Hour {
		minutes := int(duration.Minutes())
		if minutes == 1 {
			return "1 min ago"
		}
		return fmt.Sprintf("%d mins ago", minutes)
	} else if duration < 24*time.Hour {
		hours := int(duration.Hours())
		if hours == 1 {
			return "1 hour ago"
		}
		return fmt.Sprintf("%d hours ago", hours)
	} else {
		days := int(duration.Hours() / 24)
		if days == 1 {
			return "1 day ago"
		}
		return fmt.Sprintf("%d days ago", days)
	}
}